# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Long random string; it becomes part of the webhook URL (?key=...)
MONO_WEBHOOK_SECRET=

# Personal token from https://api.monobank.ua — only used by scripts/register-webhook.js
MONO_TOKEN=

# Account id(s) that may confirm orders (comma-separated); printed by register-webhook
MONO_ACCOUNT_ID=

# Card number shown to customers in the invoice, and the demo price
CARD_NUMBER=
PRICE_UAH=100

PORT=3000

# Optional: shared store for serverless / several instances (Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
